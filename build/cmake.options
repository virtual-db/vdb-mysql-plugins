# CMake options for every mysqld build. RelWithDebInfo without -g: the same
# -O2 code as Oracle's builds, without the debug info the install would strip
# anyway. lld links faster; system ICU skips compiling the bundled copy.
-DCMAKE_BUILD_TYPE=RelWithDebInfo
-DCMAKE_C_FLAGS_RELWITHDEBINFO=-O2 -DNDEBUG
-DCMAKE_CXX_FLAGS_RELWITHDEBINFO=-O2 -DNDEBUG
-DWITH_LD=lld
-DWITH_ICU=system
-DCMAKE_INSTALL_PREFIX=/usr/local/mysql
-DWITH_SSL=system
-DWITH_ZLIB=bundled
-DWITH_EDITLINE=bundled
-DWITH_PROTOBUF=bundled
-DWITH_ROUTER=OFF
-DWITH_NDB=OFF
-DWITH_NDBCLUSTER_STORAGE_ENGINE=OFF
-DWITH_MYSQLX=OFF
-DWITHOUT_GROUP_REPLICATION=ON
-DWITH_UNIT_TESTS=OFF
-DDOWNLOAD_BOOST=OFF
-DINSTALL_MYSQLTESTDIR=
